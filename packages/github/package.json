{
  "name": "@ruyojs/github",
  "version": "0.1.0",
  "description": "GitHub adapter for Ruyo: render repositories, issues, pull requests, and more as PNG cards",
  "keywords": [
    "ruyo",
    "ruyo-adapter",
    "github",
    "link-preview"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsyzxjn/ruyo.git",
    "directory": "packages/github"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "licenses"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-wasm.mjs ruyo_github && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0"
  },
  "peerDependencies": {
    "@ruyojs/core": "workspace:^"
  },
  "devDependencies": {
    "@ruyojs/core": "workspace:^"
  },
  "imports": {
    "#wasm": "./wasm/ruyo_github.js"
  }
}
